# Optional — only needed for OpenAI-backed embeddings or LLM features
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Embeddings (default: ChromaDB bundled ONNX MiniLM — no API key required)
EMBEDDING_PROVIDER=chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PERSIST_DIR=data/chroma_db
RESUMES_DIR=resumes
JOB_DESCRIPTIONS_DIR=job_descriptions
REPORTS_DIR=reports
